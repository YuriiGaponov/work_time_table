# --- Приложение ---
# Секретный ключ для криптографических операций (Django, Flask и др.)
# Должен быть уникальным, случайным и недоступным третьим лицам
SECRET_KEY=your_secret_key

# Режим отладки приложения
# True — развёрнутый режим разработки (подробные ошибки, автоперезагрузка)
# False — продакшен-режим (скрытые ошибки, повышенная безопасность)
DEBUG=True or False

# --- Логирование ---
# Путь к директории для хранения лог-файлов
# Используйте абсолютный или относительный путь
# Пример: /var/log/myapp/ или ./logs/
LOG_DIR=path/to/logfile

# Кодировка для лог-файлов
# Рекомендуется использовать utf-8 для поддержки всех символов
LOG_ENCODING=utf-8

# --- Шаблоны ---
# Путь к директории с шаблонами (HTML, Jinja2 и др.)
# Используйте абсолютный или относительный путь
# Пример: /app/templates/ или ./templates/
TEMPLATES_FOLDER=path/to/templates

# --- Производственный календарь ---
# Минимальный год, доступный в производственном календаре на calendar.kuzyak.in
# Определяет нижнюю границу диапазона лет для операций с календарными данными
MIN_YEAR=2023

# Максимальный год, доступный в производственном календаре на calendar.kuzyak.in
# Определяет верхнюю границу диапазона лет для операций с календарными данными
# Обратите внимание: значение может потребовать обновления при расширении данных на сайте
MAX_YEAR=2026
