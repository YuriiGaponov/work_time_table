# --- Приложение ---
# Секретный ключ для криптографических операций (Django, Flask и др.)
# Должен быть уникальным, случайным и недоступным третьим лицам
SECRET_KEY=your_secret_key

# Режим отладки приложения
# True — развёрнутый режим разработки (подробные ошибки, автоперезагрузка)
# False — продакшен-режим (скрытые ошибки, повышенная безопасность)
DEBUG=True or False

# --- Логирование ---
# Путь к директории для хранения лог-файлов
# Используйте абсолютный или относительный путь
# Пример: /var/log/myapp/ или ./logs/
LOG_DIR=path/to/logfile

# Кодировка для лог-файлов
# Рекомендуется использовать utf-8 для поддержки всех символов
LOG_ENCODING=utf-8

# Максимальный размер одного лог‑файла в байтах
# Когда файл достигает указанного размера, выполняется ротация (создание нового файла)
# Пример: 1000000 = 1 МБ
LOG_MAX_BYTES=1000000

# Количество резервных копий лог‑файлов, сохраняемых при ротации
# После превышения этого числа самые старые файлы удаляются
# Пример: при значении 3 будут храниться текущий лог + 3 предыдущих версии
LOG_BACKUP_COUNT=3


# --- Шаблоны ---
# Путь к директории с шаблонами (HTML, Jinja2 и др.)
# Используйте абсолютный или относительный путь
# Пример: /app/templates/ или ./templates/
TEMPLATES_FOLDER=path/to/templates

# --- Данные ---
# Путь к директории для хранения данных приложения
# Используйте абсолютный или относительный путь
# Пример: /var/data/myapp/ или ./data/
DATA_DIR=data/dir

# --- База данных ---
# Название базы данных
# Укажите имя целевой базы данных, к которой осуществляется подключение
# Должно совпадать с именем БД на сервере СУБД
# Пример: myapp_db, project_production, test_database
DB_NAME=database

# URL для подключения к базе данных в формате:
# dialect+driver://username:password@host:port/database
#
# Параметры:
# - dialect — СУБД (например, postgresql, mysql, sqlite, oracle, mssql)
# - driver — используемый драйвер (например, psycopg2, pymysql, pysqlite)
# - username — имя пользователя для аутентификации
# - password — пароль пользователя (рекомендуется не хранить в открытом виде в конфиге)
# - host — адрес сервера БД (localhost, IP или доменное имя)
# - port — порт сервера БД (по умолчанию: 5432 для PostgreSQL, 3306 для MySQL и т. д.)
# - database — название целевой базы данных
DATABASE_URL=dialect+driver://username:password@host:port/database

# Дополнительный URL для подключения к базе данных через SQLAlchemy
# В данном приложении используется для создания синхронного движка БД,
# когда использование асинхронных сессий нецелесообразно
SQLALCHEMY_DATABASE_URI=dialect+driver://username:password@host:port/database

# --- Производственный календарь ---
# Минимальный год, доступный в производственном календаре на calendar.kuzyak.in
# Определяет нижнюю границу диапазона лет для операций с календарными данными
MIN_YEAR=2023

# Максимальный год, доступный в производственном календаре на calendar.kuzyak.in
# Определяет верхнюю границу диапазона лет для операций с календарными данными
# Обратите внимание: значение может потребовать обновления при расширении данных на сайте
MAX_YEAR=2026
