# --- Приложение ---
# Секретный ключ для криптографических операций (Django, Flask и др.)
# Должен быть уникальным, случайным и недоступным третьим лицам
SECRET_KEY=your_secret_key

# Режим отладки приложения
# True — развёрнутый режим разработки (подробные ошибки, автоперезагрузка)
# False — продакшен-режим (скрытые ошибки, повышенная безопасность)
DEBUG=True or False

# --- Логирование ---
# Путь к директории для хранения лог-файлов
# Используйте абсолютный или относительный путь
# Пример: /var/log/myapp/ или ./logs/
LOG_DIR=path/to/logfile

# Кодировка для лог-файлов
# Рекомендуется использовать utf-8 для поддержки всех символов
LOG_ENCODING=utf-8

# --- Шаблоны ---
# Путь к директории с шаблонами (HTML, Jinja2 и др.)
# Используйте абсолютный или относительный путь
# Пример: /app/templates/ или ./templates/
TEMPLATES_FOLDER=path/to/templates

# --- База данных ---
# URL для подключения к базе данных в формате:
# dialect+driver://username:password@host:port/database
#
# Параметры:
# - dialect — СУБД (например, postgresql, mysql, sqlite, oracle, mssql)
# - driver — используемый драйвер (например, psycopg2, pymysql, pysqlite)
# - username — имя пользователя для аутентификации
# - password — пароль пользователя (рекомендуется не хранить в открытом виде в конфиге)
# - host — адрес сервера БД (localhost, IP или доменное имя)
# - port — порт сервера БД (по умолчанию: 5432 для PostgreSQL, 3306 для MySQL и т. д.)
# - database — название целевой базы данных
DATABASE_URL=dialect+driver://username:password@host:port/database